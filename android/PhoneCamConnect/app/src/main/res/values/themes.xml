<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Phase 1 minimal dark theme. Material library is not a direct dependency,
         so we base on a platform dark theme to avoid a hard build failure. -->
    <style name="Theme.PhoneCam" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pc_background</item>
        <item name="android:statusBarColor">@color/pc_background</item>
        <item name="android:navigationBarColor">@color/pc_background</item>
        <item name="android:textColorPrimary">@color/pc_text_primary</item>
        <item name="android:textColorSecondary">@color/pc_text_secondary</item>
        <item name="android:colorPrimary">@color/pc_primary</item>
        <item name="android:colorAccent">@color/pc_action</item>
    </style>
</resources>
