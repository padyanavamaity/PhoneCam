<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView style="@style/SettingsLabel" android:text="Device" />
        <TextView
            android:id="@+id/tvDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" />
        <TextView style="@style/SettingsLabel" android:text="Device name" />
        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Front Camera"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLength="40"
            android:textColor="@color/text_primary" />

        <TextView style="@style/SettingsLabel" android:text="Resolution (supported by this camera)" />
        <Spinner android:id="@+id/spRes" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView style="@style/SettingsLabel" android:text="Frame rate" />
        <Spinner android:id="@+id/spFps" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView style="@style/SettingsLabel" android:text="Max video bitrate (kbps)" />
        <EditText
            android:id="@+id/etBitrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:textColor="@color/text_primary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Start streaming when app opens"
            android:textColor="@color/text_primary" />

        <TextView style="@style/SettingsLabel" android:text="About / connection diagnostics" />
        <TextView
            android:id="@+id/tvDiag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save" />
    </LinearLayout>
</ScrollView>